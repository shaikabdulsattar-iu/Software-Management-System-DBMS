# Render / production
NODE_ENV=production
PORT=10000
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Use either DATABASE_URL OR the individual DB_* variables.
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:3306/software_management

# Alternative:
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=software_management
# DB_SSL=true
